# 依赖
node_modules/
server/vendor/

# 构建产物
dist/
*.exe
*.exe~
*.test
*.out

# 本地配置（数据库密码、JWT 密钥等）
.env
.env.local
server/.env

# 前端 .env 只含端口、代理地址等非敏感变量，需要进版本库
!web/.env
!web/.env.development
!web/.env.production

# 运行期数据（上传文件、缓存、日志）
server/public/storage/*
!server/public/storage/.gitkeep
*.log

# 编辑器与系统文件
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# 前端构建缓存
web/.auto-import.json
web/node_modules/
web/dist/
